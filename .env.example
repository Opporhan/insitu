# Copy to .env.local and fill in. Get a free key at https://aistudio.google.com/apikey
# Without it, a rule-based fallback translator answers simple questions.
GEMINI_API_KEY=

# Optional: global daily request cap across all server instances (free Upstash Redis).
# Leave empty to disable. INSITU_DAILY_LIMIT defaults to 2000 requests per UTC day.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INSITU_DAILY_LIMIT=
